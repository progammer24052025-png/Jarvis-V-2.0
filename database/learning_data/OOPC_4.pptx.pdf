--- Page 40 ---
4/25/2025 Ms. Neeshu Chaudhary, CSE dept 40▪ class derived : public base 
▪  {
▪ public: 
▪ void print() 
▪  {
▪  cout << "print derived class\n"; 
▪  }
▪  void show() 
▪  {
▪  cout << "show derived class\n"; 
▪  }
▪ };
▪ int main() 
▪ { 
▪    base* bptr; 
▪    derived d; 
▪     bptr = &d;    // Virtual function, binded at runtime    
▪ bptr->print();    // Non-virtual function, binded at compile time 
▪     bptr->show();    return 0;} 


