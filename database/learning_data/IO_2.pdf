6. Copy one file to another (ifstream  + ofstream ) 
#include <iostream>  
#include <fstream>  
using namespace std;  
 
int main() {  
    ifstream fin("file1.txt");  
    ofstream fout("file2.txt");  
    string line;  
 
    while(getli ne(fin, line)) {  
        fout << line << endl;  
    } 
 
    fin.close();  
    fout.close();  
    cout << "File copied";  
} 
Output:  
File copied  
 
7. Use  fstream  for read + write  
#include <iostream>  
#include <fstream>  
using namespace std;  
 
int main() {  
    fstream file("file3.txt", ios::in | ios::out | ios::trunc);  
 
    file << "C++ fstream Example";  
 
    file.seekg(0); // move pointer to beginning  
 

--- Page 10 ---
    string data;  
    getline(file, data);  
    cout << data;  
 
    file.close();  
} 
Output:  
C++ fstream Example  
 
Quick Viva Tip:  
 ofstream  → write  
 ifstream  → read  
 fstream  → read + write  
 