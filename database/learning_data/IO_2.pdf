1. Write data to a file (ofstream ) 
#include <iostream>  
#include <fstream>  
using namespace std;  
 
int main() {  
    ofstream fout("file1.txt");  
    fout << "Hello C++ File Handling";  
    fout.close();  
    cout << "Data writ ten"; 
} 
Output:  
Data written  
File Content (file1.txt ): 
Hello C++ File Handling  
 
2. Read data from a file (ifstream ) 
#include <iostream>  
#include <fstream>  
using namespace std;  
 
int main() {  
    ifstream fin("file1.txt");  
    string data;  
    getline(fin, data);  
    cout << data;  
    fin.close();  
} 
Output:  
Hello C++ File Handling  
 

--- Page 8 ---
3. Append data to a file (ofstream  with  ios::app ) 
#include <iostream>  
#include <fstream>  
using namespace std ; 
 
int main() {  
    ofstream fout("file1.txt", ios::app);  
    fout << " \nAppended Line";  
    fout.close();  
    cout << "Data appended";  
} 
Output:  
Data appended  
Updated File:  
Hello C++ File Handling  
Appended Line  
 
4. Read entire file using loop  
#include <iostream>  
#include <fstream>  
using namespace std;  
 
int main() {  
    ifstream fin("file1.txt");  
    string line;  
 
    while(getline(fin, line)) {  
        cout << line << endl;  
    } 
    fin.close();  
} 
Output:  
Hello C++ File Handling  
Appended Line  
 
5. Count number of words in file  
#include <iostream>  
#include <fstream>  
using namespace std;  
 
int main() {  
    ifstream fin("file1.txt");  

--- Page 9 ---
    string word;  
