--- Page 1 ---
 
1. Write to a File  
Creates a file and writes content into it.  
#include <stdio.h>  
 
int main() {  
    FILE *fp;  
    fp = fopen("file.txt", "w");  
 
    fprintf(fp, "Hello, this is file writing example. \n"); 
 
    fclose(fp);  
    return 0;  
} 
 
2. Read from a File  
Reads content from an existing file.  
#include <stdio.h>  
 
int main() {  
    FILE *fp;  
    char ch;  
 
    fp = fopen("file.txt", "r");  
 
    while ((ch = fgetc(fp)) != EOF) {  
        printf("%c", ch);  
    } 
 
    fclose(fp);  
    return 0;  
} 
 
3. Append to a File  
Adds content at the end of the file.  
#include <stdio.h>  
 
int main() {  
    FILE *fp;  
 
    fp = fopen("file.txt", "a");  
 
    fprintf(fp, "This line is appended. \n"); 

--- Page 2 ---
 
    fclose(fp);  
    return 0;  
} 
 
4. Copy Content from One File to Another  
#include <stdio.h>  
 
int main() {  
    FILE *fp1, *fp2;  
    char ch;  
 
    fp1 = fopen("file.txt", "r");  
    fp2 = fopen("copy.txt", "w");  
 
    while ((ch = fgetc(fp1)) != EOF) {  
        fputc(ch, fp2);  
    } 
 
    fclose(fp1);  
    fclose(fp2);  
    return 0;  
} 
 
5. Count Characters in a File  
#include <stdio.h>  
 
int main() {  
    FILE *fp;  
    char ch;  
    int count = 0;  
 
    fp = fopen("file.txt", "r");  
 
    while ((ch = fgetc(fp)) != EOF) {  
        count++;  
    } 
 
    printf("Total characters: %d", count);  
 
    fclose(fp);  
    return 0;  
} 
 
6. Count Lines in a File  
#include <stdio.h>  
 
int main() {  

--- Page 3 ---
    FILE *fp;  
    char ch;  
    int lines = 0;  
 
    fp = fopen("file.txt", "r");  
 
    while ((ch = fgetc(fp)) != EOF) {  
        if (ch == ' \n') { 
            lines++; 
        } 
    } 
 
    printf("Total lines: %d", lines);  
 
    fclose(fp);  
    return 0;  
} 
 
7. Read and Write Using fgets  and fputs  
#include <stdio.h>  
 
int main() {  
    FILE *fp;  
    char str[100];  
 
    fp = fopen("file.txt", "w");  
 
    printf("Enter a string: ");  
    fgets(str, sizeof(str), stdin);  
 
    fputs(str, fp);  
 
    fclose(fp);  
 
    fp = fopen("file.txt", "r");  
 
    fgets(str, sizeof(str), fp);  
    printf("File content: %s", str);  
 
    fclose(fp) ; 
    return 0;  
} 
 
 
 
 
 

