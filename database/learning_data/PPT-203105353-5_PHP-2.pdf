47Recursion 
▪<?php    
▪function  fact($n)    
▪{    
▪    if ($n < 0)    
▪        return -1; /*Wrong value*/     
▪    if ($n == 0)    
▪        return 1; /*Terminating condition*/     
▪    return ($n * fact($n -1));    
▪}    
▪    
▪echo fact(5);    
▪?>  


