68Interface 
Interface tell what methods a class should implement 
<?php
interface  productfeature {
    function  images();
    function  owner();
}
class product implements  productfeature {
    function  images(){
        echo "PI";
    }
    function  owner(){
        echo "WD";
    }
}
$product =new product();
$product ->images();
$product ->owner();

